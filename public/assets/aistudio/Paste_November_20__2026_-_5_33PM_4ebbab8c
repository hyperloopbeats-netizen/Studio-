      // Telemetry shared from audio DSP thread to render loop
      const dspTelemetry = {
        isSilentGap: true,
        gapCondensePct: 0,
        waveRoundVal: 0,
        sonicSegmentCount: 0,
        envTrace: new Float32Array(64)
      };
      let envTraceIdx = 0;

      function createHyperCompressorNode(ctx) {
        const bufferSize = 1024;
        const proc = ctx.createScriptProcessor(bufferSize, 1, 1);

        // Ring buffer to hold active sonic segments & smoothly condense silence segments
        const ringCap = ctx.sampleRate * 2;
        const ringBuf = new Float32Array(ringCap);
        const lookaheadCushion = 512; // Keeps a safety cushion so segment joins never click
        let writeIdx = 0;
        let readIdx = 0;
        let bufferedSamples = 0;

        let rmsEnv = 0;
        let wasActive = false;
        let silenceRunSamples = 0;
        let wavePhase = 0;
        let spliceSmoothEnv = 1.0;
        let prevOutSample = 0;

        proc.onaudioprocess = (event) => {
          const input = event.inputBuffer.getChannelData(0);
          const output = event.outputBuffer.getChannelData(0);
          const sr = ctx.sampleRate;

          if (!hyperParams.enabled) {
            output.set(input);
            dspTelemetry.isSilentGap = false;
            dspTelemetry.gapCondensePct = 0;
            return;
          }

          const avgFloor = (hyperParams.s1Floor + hyperParams.s2Floor + hyperParams.s3Floor) / 3;
          const avgCondense = (hyperParams.s1Condense + hyperParams.s2Condense + hyperParams.s3Condense) / 3;
          const avgRound = (hyperParams.s1Round + hyperParams.s2Round + hyperParams.s3Round + hyperParams.s4SpliceRound) / 4;
          const phaseInc = (Math.PI * 2 * hyperParams.s4WaveHz) / sr;

          let lastSampleActive = false;
          let activeSamplesInBlock = 0;

          for (let i = 0; i < input.length; i++) {
            const s = input[i];
            const absS = Math.abs(s);

            // Fast attack / smooth release envelope with subtle hysteresis around silence floor
            const envAlpha = absS > rmsEnv ? 0.015 : 0.0018;
            rmsEnv = rmsEnv * (1 - envAlpha) + absS * envAlpha;

            const threshold = wasActive ? avgFloor * 0.85 : avgFloor;
            const isActiveSegment = rmsEnv >= threshold;
            lastSampleActive = isActiveSegment;

            if (isActiveSegment) {
              activeSamplesInBlock += 1;
              if (!wasActive) {
                dspTelemetry.sonicSegmentCount += 1;
              }
              silenceRunSamples = 0;
            } else {
              silenceRunSamples += 1;
            }
            wasActive = isActiveSegment;

            // Push incoming sample into ring buffer
            ringBuf[writeIdx] = s;
            writeIdx = (writeIdx + 1) % ringCap;
            bufferedSamples = Math.min(ringCap, bufferedSamples + 1);

            // Smoothly condense silence gaps while preserving lookahead cushion and active segments
            let stepInt = 1;
            if (!isActiveSegment && bufferedSamples > lookaheadCushion) {
              const silenceSec = silenceRunSamples / sr;
              if (silenceSec > 0.04) {
                // Ramp skip speed smoothly over 60ms so boundary transitions stay click-free
                const ramp = Math.min(1.0, (silenceSec - 0.04) / 0.06);
                const extraSkip = avgCondense * (1.0 + hyperParams.s4Density * 2.5) * ramp;
                const maxAvail = Math.max(1, bufferedSamples - lookaheadCushion);
                stepInt = Math.min(maxAvail, Math.max(1, Math.round(1 + extraSkip)));
              }
            }

            let outSample = 0;
            if (bufferedSamples > 0) {
              // Linearly interpolate fractional read pointer for smooth pitch/time boundary behavior
              const idx0 = Math.floor(readIdx) % ringCap;
              const idx1 = (idx0 + 1) % ringCap;
              const frac = readIdx - Math.floor(readIdx);
              outSample = ringBuf[idx0] * (1 - frac) + ringBuf[idx1] * frac;

              const actualStep = Math.min(bufferedSamples, stepInt);
              readIdx = (readIdx + actualStep) % ringCap;
              bufferedSamples -= actualStep;
            }

            // Wave system rounds off segment transitions & adds real-time dynamic compression
            wavePhase += phaseInc;
            if (wavePhase > Math.PI * 2) wavePhase -= Math.PI * 2;

            const targetGain = isActiveSegment
              ? 1.0
              : (1.0 - avgCondense * 0.55); // Non-destructive gap floor, preserves active peak dynamics

            const smoothAlpha = 0.002 + (1.0 - avgRound) * 0.025;
            spliceSmoothEnv = spliceSmoothEnv * (1 - smoothAlpha) + targetGain * smoothAlpha;

            // Wave rounding curve applied to dynamic envelope
            const waveMod = Math.sin(wavePhase) * 0.08 * hyperParams.s4Density * avgRound;
            const roundedEnvelope = Math.max(0.05, spliceSmoothEnv + waveMod);

            // Real-time dynamic compression on density without clipping raw sonic peaks
            const dynComp = 1.0 / (1.0 + hyperParams.s4Density * 0.25 * Math.max(0, Math.abs(outSample) - 0.7));
            let processed = outSample * roundedEnvelope * dynComp;

            // Gentle slew-rate smoothing on skipped gap boundaries to eliminate micro-clicks
            if (stepInt > 1) {
              processed = prevOutSample * 0.25 + processed * 0.75;
            }
            prevOutSample = processed;

            output[i] = Math.max(-1.0, Math.min(1.0, processed));
          }

          dspTelemetry.isSilentGap = activeSamplesInBlock === 0 && !lastSampleActive;
          dspTelemetry.gapCondensePct = Math.round(
            Math.min(100, (silenceRunSamples > 0 ? avgCondense * (1.0 + hyperParams.s4Density * 0.6) * 65 : avgCondense * 35))
          );
          dspTelemetry.waveRoundVal = Math.sin(wavePhase) * avgRound;
          dspTelemetry.envTrace[envTraceIdx] = Math.min(1.0, rmsEnv * 3.5);
          envTraceIdx = (envTraceIdx + 1) % dspTelemetry.envTrace.length;
        };

        return proc;
      }

