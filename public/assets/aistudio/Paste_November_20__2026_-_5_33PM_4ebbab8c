      // Real-time Silence-Segment Condenser + Wave-Rounding ScriptProcessor DSP
      // Condenses silence gaps between sonic segments without squashing peak levels.
      let audioCtx = null;
      let analyser = null;
      let dataArray = null;
      let hyperProcessor = null;
      let hyperGainNode = null;
      let isSynthPlaying = false;
      let isMicActive = false;
