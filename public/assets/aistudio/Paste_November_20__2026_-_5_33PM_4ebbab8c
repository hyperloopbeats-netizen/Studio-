      }

      btnSynth.addEventListener('click', () => {
        if (!initAudio()) return;

        if (isSynthPlaying) {
          stopSynth();
          updateSourceHud();
          showBanner('432Hz Sovereign Drone stopped.');
          return;
        }

        try {
          const freqs = [54, 108, 216, 432];
          synthGain = audioCtx.createGain();
          synthGain.gain.value = 0.14;
          synthGain.connect(hyperProcessor);

          freqs.forEach((f, idx) => {
            const osc = audioCtx.createOscillator();
            const g = audioCtx.createGain();
            osc.type = idx === 0 ? 'sine' : 'triangle';
            osc.frequency.value = isBluePhaseActive ? f * 1.015 : f;
            g.gain.value = 1 / (idx + 1);
            osc.connect(g);
            g.connect(synthGain);
            osc.start();
            synthNodes.push(osc);
          });

          isSynthPlaying = true;
          btnSynth.textContent = '■ STOP DRONE';
          btnSynth.classList.add('bg-amber-400/35', 'border-amber-200');
          updateSourceHud();
          showBanner('432Hz Drone routed through Hyper-Compressor.');
        } catch (err) {
          showBanner('Could not start harmonic synth.');
        }
      });

      btnMic.addEventListener('click', async () => {
        if (isMicActive) {
          stopMic();
          updateSourceHud();
          showBanner('Microphone input muted.');
          return;
        }

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          showBanner('Microphone API not supported in this browser.');
          return;
        }

        if (!initAudio()) return;

        try {
          micStream = await navigator.mediaDevices.getUserMedia({
            audio: {
              echoCancellation: true,
              noiseSuppression: true,
              autoGainControl: true
            }
          });
          micSource = audioCtx.createMediaStreamSource(micStream);
          micSource.connect(hyperProcessor);

          isMicActive = true;
          btnMic.textContent = '● MIC ON';
          btnMic.classList.add('bg-sky-500/30', 'border-sky-400', 'text-sky-100');
          updateSourceHud();
          showBanner('Live mic routed into Silence-Gap Hyper-Compressor.');
        } catch (err) {
          showBanner('Microphone permission denied or unavailable.');
        }
      });

      const inputAudio = document.getElementById('input-audio');
      inputAudio.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        if (!initAudio()) return;

        try {
          if (uploadedAudioEl) {
            uploadedAudioEl.pause();
            if (uploadedAudioEl.src) {
              URL.revokeObjectURL(uploadedAudioEl.src);
            }
          }
          if (uploadedSource) {
            try { uploadedSource.disconnect(); } catch (_) {}
            uploadedSource = null;
          }

          const url = URL.createObjectURL(file);
          uploadedAudioEl = new Audio(url);
          uploadedAudioEl.crossOrigin = 'anonymous';
          uploadedSource = audioCtx.createMediaElementSource(uploadedAudioEl);
          uploadedSource.connect(hyperProcessor);

          uploadedAudioEl.addEventListener('play', updateSourceHud);
          uploadedAudioEl.addEventListener('pause', updateSourceHud);
          uploadedAudioEl.addEventListener('ended', updateSourceHud);

          uploadedAudioEl.play().then(() => {
            updateSourceHud();
            showBanner(`Hyper-compressing silence gaps in: ${file.name}`);
          }).catch(() => {
            showBanner('Tap again or check audio file playback permission.');
          });
        } catch (err) {
          showBanner('Unable to process uploaded audio file.');
        }
      });

      // --- 5. Audio Sensitivity Presets, Beat Detection & HUD Visualizations ---
      const PRESETS = {
        bass: {
          label: 'BASS CLUB',
          hint: 'SUB 20–150Hz',
          minFloor: 0.15,
          sensitivity: 1.40,
          cooldown: 0.25,
          bassWeight: 1.0,
          midWeight: 0.15,
          nodeHitThreshold: 0.34,
          banner: 'Preset: BASS CLUB — tuned for heavy sub-bass & kick transients.'
        },
        vocal: {
          label: 'VOCAL / VOICE',
          hint: 'VOICE + MID',
          minFloor: 0.08,
          sensitivity: 1.22,
          cooldown: 0.19,
          bassWeight: 0.45,
          midWeight: 0.85,
          nodeHitThreshold: 0.24,
          banner: 'Preset: VOCAL / VOICE — tuned for speech syllables & mid-band peaks.'
        },
        quiet: {
          label: 'QUIET ROOM',
          hint: 'LOW-GAIN MIC',
          minFloor: 0.035,
          sensitivity: 1.15,
          cooldown: 0.22,
          bassWeight: 0.65,
          midWeight: 0.65,
          nodeHitThreshold: 0.15,
          banner: 'Preset: QUIET ROOM — high-sensitivity threshold for soft mic input.'
        }
      };

      let activePresetKey = 'bass';
      let currentPreset = PRESETS.bass;
      let autoBeatEnabled = true;
      let beatSensitivity = currentPreset.sensitivity;
      let beatCount = 0;
      let transientEnergyAvg = 0.0;
      let lastBeatRealTime = -10.0;

      const sliderBeatSens = document.getElementById('slider-beat-sens');
      const valBeatSens = document.getElementById('val-beat-sens');
      const hudPresetEl = document.getElementById('hud-preset');
      const presetBandHintEl = document.getElementById('preset-band-hint');

      function applySensitivityPreset(key, announce = true) {
        const preset = PRESETS[key];
        if (!preset) return;
        activePresetKey = key;
        currentPreset = preset;
        beatSensitivity = preset.sensitivity;
        transientEnergyAvg = 0.0;

        if (sliderBeatSens) sliderBeatSens.value = preset.sensitivity.toFixed(2);
        if (valBeatSens) valBeatSens.textContent = preset.sensitivity.toFixed(2) + 'x';
        if (hudPresetEl) hudPresetEl.textContent = preset.label;
        if (presetBandHintEl) presetBandHintEl.textContent = preset.hint;

        document.querySelectorAll('.preset-btn').forEach((btn) => {
          const isSelected = btn.dataset.preset === key;
          btn.classList.toggle('bg-amber-500/30', isSelected);
          btn.classList.toggle('border-amber-400', isSelected);
          btn.classList.toggle('text-amber-100', isSelected);
          btn.classList.toggle('font-bold', isSelected);
          btn.classList.toggle('border-amber-500/30', !isSelected);
          btn.classList.toggle('text-amber-300', !isSelected);
        });

        if (announce) {
          showBanner(preset.banner);
        }
      }

      document.querySelectorAll('.preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          applySensitivityPreset(btn.dataset.preset, true);
        });
      });

      const spectrumCanvas = document.getElementById('fft-spectrum-canvas');
      const spectrumCtx = spectrumCanvas.getContext('2d');
      const beatEnergyBar = document.getElementById('beat-energy-bar');
      const beatThresholdMarker = document.getElementById('beat-threshold-marker');
      const hudBeatThresh = document.getElementById('hud-beat-thresh');

      function resizeSpectrumCanvas() {
        if (!spectrumCanvas) return;
        const rect = spectrumCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const w = Math.max(1, Math.floor(rect.width * dpr));
        const h = Math.max(1, Math.floor(rect.height * dpr));
        if (spectrumCanvas.width !== w || spectrumCanvas.height !== h) {
          spectrumCanvas.width = w;
          spectrumCanvas.height = h;
        }
      }

      function renderSpectrumAndBeatMeter(meterEnergy, effectiveThreshold, blueMix) {
        resizeSpectrumCanvas();

        const clampedEnergyPct = Math.max(0, Math.min(100, meterEnergy * 100));
        const clampedThreshPct = Math.max(2, Math.min(96, effectiveThreshold * 100));
        beatEnergyBar.style.width = clampedEnergyPct.toFixed(1) + '%';
        beatThresholdMarker.style.left = clampedThreshPct.toFixed(1) + '%';
        hudBeatThresh.textContent = 'THR: ' + clampedThreshPct.toFixed(1) + '%';

        if (blueMix > 0.5) {
          beatEnergyBar.className = 'h-full w-0 bg-gradient-to-r from-sky-500 via-cyan-300 to-white transition-[width] duration-75';
        } else {
          beatEnergyBar.className = 'h-full w-0 bg-gradient-to-r from-amber-500 via-yellow-300 to-amber-100 transition-[width] duration-75';
        }

        if (!spectrumCtx) return;
        const w = spectrumCanvas.width;
        const h = spectrumCanvas.height;
        spectrumCtx.clearRect(0, 0, w, h);

        // Draw 28 FFT spectrum bars + wave-rounded envelope curve across the scope
        const binCount = 28;
        const gap = Math.max(1, Math.floor(w / (binCount * 5)));
        const barWidth = Math.max(2, (w - gap * (binCount - 1)) / binCount);

        for (let i = 0; i < binCount; i++) {
          let norm = 0;
          if (analyser && dataArray) {
            const idx = Math.min(dataArray.length - 1, Math.floor((i / binCount) * 96));
            norm = dataArray[idx] / 255;
          } else {
            norm = 0.06 + 0.04 * Math.sin(uniforms.uTime.value * 2.2 + i * 0.35);
          }

          const barH = Math.max(2, norm * (h - 4));
          const x = i * (barWidth + gap);
          const y = h - barH;

          spectrumCtx.fillStyle = blueMix > 0.5
            ? 'rgba(56, 189, 248, 0.55)'
            : 'rgba(245, 158, 11, 0.55)';
          spectrumCtx.fillRect(x, y, barWidth, barH);
        }

        // Overlay wave-rounded envelope curve
        spectrumCtx.beginPath();
        const traceLen = dspTelemetry.envTrace.length;
        for (let i = 0; i < traceLen; i++) {
          const sampleIdx = (envTraceIdx + i) % traceLen;
          const v = dspTelemetry.envTrace[sampleIdx];
          const px = (i / (traceLen - 1)) * w;
          const py = h - 3 - v * (h - 6);
          if (i === 0) spectrumCtx.moveTo(px, py);
          else spectrumCtx.lineTo(px, py);
        }
        spectrumCtx.strokeStyle = blueMix > 0.5 ? '#e0f2fe' : '#fef08a';
        spectrumCtx.lineWidth = 2;
        spectrumCtx.stroke();
      }

      const btnAutoBeat = document.getElementById('btn-auto-beat');
      const hudBeatsEl = document.getElementById('hud-beats');

      btnAutoBeat.addEventListener('click', () => {
        autoBeatEnabled = !autoBeatEnabled;
        btnAutoBeat.textContent = autoBeatEnabled
          ? '◎ AUTO BEAT SHOCKWAVES: ON'
          : '◎ AUTO BEAT SHOCKWAVES: OFF';
        btnAutoBeat.classList.toggle('bg-amber-500/25', autoBeatEnabled);
        btnAutoBeat.classList.toggle('border-amber-400', autoBeatEnabled);
        btnAutoBeat.classList.toggle('border-amber-500/30', !autoBeatEnabled);
        showBanner(autoBeatEnabled ? 'Auto beat-triggered shockwaves enabled.' : 'Auto beat-triggered shockwaves paused.');
      });

      sliderBeatSens.addEventListener('input', (e) => {
        beatSensitivity = parseFloat(e.target.value);
        valBeatSens.textContent = beatSensitivity.toFixed(2) + 'x';
      });

      // --- 6. Shader & HUD Controls ---
      let speedMultiplier = 1.0;

      document.getElementById('slider-depth').addEventListener('input', (e) => {
        uniforms.uDepth.value = parseFloat(e.target.value);
        document.getElementById('val-depth').textContent = uniforms.uDepth.value.toFixed(2);
      });

      document.getElementById('slider-tension').addEventListener('input', (e) => {
        uniforms.uTension.value = parseFloat(e.target.value);
        document.getElementById('val-tension').textContent = uniforms.uTension.value.toFixed(2);
      });

      document.getElementById('slider-speed').addEventListener('input', (e) => {
        speedMultiplier = parseFloat(e.target.value);
        document.getElementById('val-speed').textContent = speedMultiplier.toFixed(2);
      });

      document.querySelectorAll('.mode-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = parseInt(btn.dataset.mode, 10);
          uniforms.uMode.value = mode;
          coreMat.wireframe = (mode === 1);

          document.querySelectorAll('.mode-btn').forEach((b) => {
            b.classList.remove('bg-amber-500/30', 'border-amber-400', 'text-amber-100', 'font-bold');
            b.classList.add('border-amber-500/30', 'text-amber-300');
          });
          btn.classList.remove('border-amber-500/30', 'text-amber-300');
          btn.classList.add('bg-amber-500/30', 'border-amber-400', 'text-amber-100', 'font-bold');
        });
      });

      const btnBluePhase = document.getElementById('btn-blue-phase');
      const btnBlueLabel = document.getElementById('btn-blue-label');
      const hudBlueState = document.getElementById('hud-blue-state');
      const telemetryPanel = document.getElementById('telemetry-panel');
      const controlsPanel = document.getElementById('controls-panel');
      const telemetryDot = document.getElementById('telemetry-dot');

      btnBluePhase.addEventListener('click', () => {
        isBluePhaseActive = !isBluePhaseActive;
        blueTargetMix = isBluePhaseActive ? 1.0 : 0.0;
        triggerShockwave(false);

        btnBluePhase.classList.toggle('engaged', isBluePhaseActive);
        telemetryPanel.classList.toggle('blue-active', isBluePhaseActive);
        controlsPanel.classList.toggle('blue-active', isBluePhaseActive);

        if (isBluePhaseActive) {
          btnBlueLabel.textContent = 'BLUE PHASE ENGAGED // PULSE';
          hudBlueState.textContent = 'ACTIVE (ELECTRIC BLUE)';
          hudBlueState.className = 'text-sky-300 font-bold text-right';
          telemetryDot.className = 'w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping shrink-0';
          cageMat.color.setHex(0x38bdf8);
          pMat.color.setHex(0x7dd3fc);
          gridHelper.setColors(0x0284c7, 0x082f49);
          showBanner('Blue Phase / Sovereign Blue Pulse engaged.');
        } else {
          btnBlueLabel.textContent = 'BLUE PHASE // SOVEREIGN PULSE';
          hudBlueState.textContent = 'STANDBY (AMBER)';
          hudBlueState.className = 'text-sky-400 font-semibold text-right';
          telemetryDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse shrink-0';
          cageMat.color.setHex(0xf59e0b);
          pMat.color.setHex(0xfbbf24);
          gridHelper.setColors(0xd97706, 0x291804);
          showBanner('Returned to Amber Sovereign baseline.');
        }
      });

      document.getElementById('btn-pulse').addEventListener('click', () => {
        triggerShockwave(true);
        amberMesh.rotation.z += Math.PI / 2;
        showBanner('Zero-crossing +1D phase snap emitted.');
      });

      function setupCollapse(btnId, bodyId) {
        const btn = document.getElementById(btnId);
        const body = document.getElementById(bodyId);
        btn.addEventListener('click', () => {
          const isHidden = body.classList.toggle('hidden');
          btn.textContent = isHidden ? '[+]' : '[−]';
          if (!isHidden) {
            resizeSpectrumCanvas();
          }
        });
      }
      setupCollapse('toggle-telemetry', 'telemetry-body');
      setupCollapse('toggle-controls', 'controls-body');

      window.addEventListener('resize', () => {
        const w = Math.max(1, window.innerWidth);
        const h = Math.max(1, window.innerHeight);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        resizeSpectrumCanvas();
      });

      // --- 7. Main Render, Frequency-Zoned Cloud & Beat Detection Loop ---
      let lastTime = 0;
      let wallClockSec = 0;
      let loopStarted = false;
      let smoothedMeterEnergy = 0;

      const hudSegStateEl = document.getElementById('hud-seg-state');
      const hudGapCondEl = document.getElementById('hud-gap-cond');
      const hudWaveRoundEl = document.getElementById('hud-wave-round');
      const hudBandsEl = document.getElementById('hud-bands');
      const hudSonicSegsEl = document.getElementById('hud-sonic-segs');

      function updateFrequencyCloud(t, bassVal, midVal, trebleVal) {
        const posAttr = pGeo.getAttribute('position');
        const arr = posAttr.array;

        pMat.size = 0.042 + trebleVal * 0.055;

        for (let i = 0; i < particleCount; i++) {
          const i3 = i * 3;
          const bx = pBasePos[i3];
          const by = pBasePos[i3 + 1];
          const bz = pBasePos[i3 + 2];

          const radialDist = Math.hypot(bx, bz) + 0.001;
          const bassPush = 1.0 + bassVal * 0.22 * (1.0 / (1.0 + Math.abs(by) * 0.25));

          const midBandFactor = Math.exp(-Math.pow(by * 0.35, 2));
          const midAngle = midVal * 0.85 * midBandFactor;
          const cosM = Math.cos(midAngle);
          const sinM = Math.sin(midAngle);
          const rx = bx * cosM - bz * sinM;
          const rz = bx * sinM + bz * cosM;

          const trebleFactor = Math.min(1.0, Math.abs(by) / 5.0 + 0.25);
          const jitter = trebleVal * 0.35 * trebleFactor;
          const jx = Math.sin(t * 9.0 + i * 1.7) * jitter;
          const jy = Math.cos(t * 8.3 + i * 2.3) * jitter;
          const jz = Math.sin(t * 7.7 + i * 3.1) * jitter;

          arr[i3]     = rx * bassPush + jx;
          arr[i3 + 1] = by + Math.sin(t * 1.4 + radialDist) * 0.12 + jy;
          arr[i3 + 2] = rz * bassPush + jz;
        }
        posAttr.needsUpdate = true;

        const cageScale = 1.0 + bassVal * 0.10;
        phaseCage.scale.set(cageScale, cageScale, cageScale);
        phaseCage.rotation.y = -t * (0.15 + midVal * 0.45);
        phaseCage.rotation.z = t * (0.10 + trebleVal * 0.55);
      }

      function animate(now) {
        requestAnimationFrame(animate);
        const safeNow = typeof now === 'number' ? now : performance.now();
        const dt = lastTime > 0 ? Math.min((safeNow - lastTime) * 0.001, 0.1) : 0.016;
        lastTime = safeNow;
        wallClockSec += dt;

        const activeCondense = hyperParams.enabled
          ? (hyperParams.s1Condense + hyperParams.s2Condense + hyperParams.s3Condense) / 3
          : 0;
        const activeWaveRound = hyperParams.enabled
          ? (hyperParams.s1Round + hyperParams.s2Round + hyperParams.s3Round + hyperParams.s4SpliceRound) / 4
          : 0;

        uniforms.uGapCondense.value = activeCondense;
        uniforms.uWaveRound.value = activeWaveRound;

        // Condensing silence gaps subtly accelerates manifold time progression during active flow
        const gapTimeBoost = hyperParams.enabled ? (1.0 + activeCondense * hyperParams.s4Density * 0.35) : 1.0;
        uniforms.uTime.value += dt * speedMultiplier * gapTimeBoost;
        const t = uniforms.uTime.value;

        uniforms.uBlueMix.value = THREE.MathUtils.lerp(
          uniforms.uBlueMix.value,
          blueTargetMix,
          0.08
        );

        let bass = 0;
        let mid = 0;
        let treble = 0;
        if (analyser && dataArray) {
          analyser.getByteFrequencyData(dataArray);
          for (let i = 0; i < 12; i++) bass += dataArray[i];
          for (let i = 12; i < 48; i++) mid += dataArray[i];
          for (let i = 48; i < 110; i++) treble += dataArray[i];
          bass = (bass / (12 * 255)) * (0.5 + hyperParams.s1Condense * 0.8);
          mid = (mid / (36 * 255)) * (0.5 + hyperParams.s2Condense * 0.8);
          treble = (treble / (62 * 255)) * (0.5 + hyperParams.s3Condense * 0.8);
        }

        const weightSum = Math.max(0.1, currentPreset.bassWeight + currentPreset.midWeight);
        const rawTransientEnergy =
          (bass * currentPreset.bassWeight + mid * currentPreset.midWeight) / weightSum;

        const effectiveThreshold = Math.max(
          currentPreset.minFloor,
          transientEnergyAvg * beatSensitivity
        );

        const hasAudioInput = isMicActive || isSynthPlaying || (uploadedAudioEl && !uploadedAudioEl.paused);
        if (hasAudioInput) {
          const isTransientPeak =
            rawTransientEnergy >= effectiveThreshold &&
            (wallClockSec - lastBeatRealTime) > currentPreset.cooldown;

          if (autoBeatEnabled && isTransientPeak) {
            lastBeatRealTime = wallClockSec;
            beatCount += 1;
            hudBeatsEl.textContent = beatCount;
            triggerShockwave(rawTransientEnergy > currentPreset.nodeHitThreshold);
          }

          const alpha = rawTransientEnergy > transientEnergyAvg ? 0.045 : 0.13;
          transientEnergyAvg = transientEnergyAvg * (1 - alpha) + rawTransientEnergy * alpha;
        } else {
          transientEnergyAvg *= 0.95;
        }

        const boostGain = activePresetKey === 'quiet' ? 1.65 : activePresetKey === 'vocal' ? 1.25 : 1.0;
        const displayedEnergy = Math.min(1.0, rawTransientEnergy * boostGain);
        smoothedMeterEnergy = THREE.MathUtils.lerp(smoothedMeterEnergy, displayedEnergy, 0.24);

        uniforms.uBass.value = THREE.MathUtils.lerp(uniforms.uBass.value, bass, 0.22);
        uniforms.uMid.value = THREE.MathUtils.lerp(uniforms.uMid.value, mid, 0.22);
        uniforms.uTreble.value = THREE.MathUtils.lerp(uniforms.uTreble.value, treble, 0.22);

        amberMesh.rotation.x = t * 0.22;
        amberMesh.rotation.y = t * 0.34;
        dustSystem.rotation.y = t * 0.04;

        updateFrequencyCloud(t, uniforms.uBass.value, uniforms.uMid.value, uniforms.uTreble.value);

        for (let i = 0; i < spawnedNodes.length; i++) {
          const node = spawnedNodes[i];
          node.position.add(node.userData.vel);
          node.userData.vel.multiplyScalar(0.985);
          node.rotation.x += 0.04;
          node.rotation.y += 0.05;
        }

        hudSegStateEl.textContent = !hyperParams.enabled
          ? 'BYPASSED'
          : (dspTelemetry.isSilentGap ? 'CONDENSING GAP' : 'SONIC SEGMENT');
        hudGapCondEl.textContent = (hyperParams.enabled ? dspTelemetry.gapCondensePct : 0) + '%';
        hudWaveRoundEl.textContent = dspTelemetry.waveRoundVal.toFixed(3);
        hudBandsEl.textContent =
          Math.round(uniforms.uBass.value * 100) + '% · ' +
          Math.round(uniforms.uMid.value * 100) + '% · ' +
          Math.round(uniforms.uTreble.value * 100) + '%';
        hudSonicSegsEl.textContent = 'SEGS: ' + dspTelemetry.sonicSegmentCount;

        renderSpectrumAndBeatMeter(
          smoothedMeterEnergy,
          Math.min(0.96, effectiveThreshold * boostGain),
          uniforms.uBlueMix.value
        );

        controls.update();
        renderer.render(scene, camera);
      }

      function startLoopOnce() {
        if (loopStarted) return;
        loopStarted = true;
        animate(performance.now());
      }

      window.addEventListener('load', startLoopOnce);
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        startLoopOnce();
      }
    })();
  </script>
</body>
</html>
