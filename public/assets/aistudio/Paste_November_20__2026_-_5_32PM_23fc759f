      // ===================================================================
      // 4. MASTER TRANSPORT & 16-STEP SEQUENCER CLOCK
      // ===================================================================
      let isTransportPlaying = false;
      let currentStep = 0;
      let barCount = 1;
      let stepTimerId = null;

      function getStepIntervalMs() {
        const bpm = Math.max(60, Math.min(180, parseInt(document.getElementById('transport-bpm').value, 10) || 124));
        return (60 / bpm / 4) * 1000;
      }

      function highlightPlayingStep(stepIdx) {
        document.querySelectorAll('.step-pad.playing').forEach((el) => el.classList.remove('playing'));
        document.querySelectorAll(`[data-sub-step="${stepIdx}"], [data-drum-step="${stepIdx}"]`).forEach((el) => {
          el.classList.add('playing');
        });
        const barStr = String(barCount).padStart(2, '0');
        const stepStr = String(stepIdx + 1).padStart(2, '0');
        document.getElementById('transport-step-lcd').textContent = `${barStr}.${stepStr}`;
      }

      function tickSequencer() {
        if (!isTransportPlaying) return;

        highlightPlayingStep(currentStep);

        // Trigger Subtractor-9D step
        if (subSteps[currentStep] && subSteps[currentStep].active) {
          triggerSubtractorVoice(subSteps[currentStep].noteIdx);
        }

        // Trigger Redrum-X16 voices
        for (let r = 0; r < DRUM_CHANNELS.length; r++) {
          if (drumGrid[r][currentStep] === 1) {
            triggerDrumVoice(r);
          }
        }

        currentStep = (currentStep + 1) % 16;
        if (currentStep === 0) barCount += 1;

        stepTimerId = setTimeout(tickSequencer, getStepIntervalMs());
      }

      document.getElementById('transport-play').addEventListener('click', () => {
        if (!initStudioAudio()) return;
