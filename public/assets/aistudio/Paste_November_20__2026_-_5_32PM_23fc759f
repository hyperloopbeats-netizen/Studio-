        { active: true,  noteIdx: 4 },
        { active: false, noteIdx: 1 }
      ];

      let cvLfoToCutoff = true;
      let cvBeatToTorsion = true;

      function triggerSubtractorVoice(noteIdx, durationSec = 0.24) {
        if (!initStudioAudio()) return;
        const scaleKey = document.getElementById('sub-scale').value;
        const scale = SCALES[scaleKey] || SCALES.minor;
        const freq = scale.freqs[noteIdx % scale.freqs.length];

        const osc1Wave = document.getElementById('sub-osc1-wave').value;
        const osc2Wave = document.getElementById('sub-osc2-wave').value;
        const detune = parseFloat(document.getElementById('sub-detune').value);
        let cutoff = parseFloat(document.getElementById('sub-cutoff').value);
        const reso = parseFloat(document.getElementById('sub-reso').value);
        const decay = parseFloat(document.getElementById('sub-decay').value);

        // Apply Rear-Panel LFO CV modulation to Filter Cutoff if patched
        if (cvLfoToCutoff) {
          const lfoMod = 1.0 + 0.35 * Math.sin(performance.now() * 0.004);
          cutoff = Math.max(120, Math.min(7500, cutoff * lfoMod));
        }

        const now = audioCtx.currentTime;
        const osc1 = audioCtx.createOscillator();
        const osc2 = audioCtx.createOscillator();
        osc1.type = osc1Wave;
        osc2.type = osc2Wave;
        osc1.frequency.setValueAtTime(freq, now);
        osc2.frequency.setValueAtTime(freq * 0.5, now); // Sub octave
        osc1.detune.setValueAtTime(detune, now);
        osc2.detune.setValueAtTime(-detune, now);

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.Q.setValueAtTime(reso, now);
        filter.frequency.setValueAtTime(Math.min(9000, cutoff * 2.2), now);
        filter.frequency.exponentialRampToValueAtTime(Math.max(90, cutoff * 0.45), now + decay);

        const env = audioCtx.createGain();
        env.gain.setValueAtTime(0.001, now);
        env.gain.linearRampToValueAtTime(0.28, now + 0.012);
        env.gain.exponentialRampToValueAtTime(0.0008, now + decay + 0.05);

        osc1.connect(filter);
        osc2.connect(filter);
        filter.connect(env);
        env.connect(mixerChannels[1].input);

        osc1.start(now);
        osc2.start(now);
        osc1.stop(now + decay + 0.08);
        osc2.stop(now + decay + 0.08);
      }

      // Build Subtractor 16-Step Grid UI
      const subSeqGrid = document.getElementById('sub-seq-grid');
      function renderSubSeqGrid() {
