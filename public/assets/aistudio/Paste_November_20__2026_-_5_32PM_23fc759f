  <!-- ===================================================================== -->
  <!-- CUSTOM GLSL SHADERS FOR 9D AMBER MESH                                 -->
  <!-- ===================================================================== -->
  <script id="vertexShader" type="x-shader/x-vertex">
    uniform float uTime;
    uniform float uDepth;
    uniform float uTension;
    uniform float uBass;
    uniform float uMid;
    uniform float uTreble;
    uniform float uGapCondense;
    uniform float uWaveRound;
    uniform float uPulseTime;
    uniform float uBluePulseTime;
    uniform float uBlueMix;

    varying vec3 vNormal;
    varying vec3 vWorldPos;
    varying float vDisplacement;
    varying float vBassZone;
    varying float vMidZone;
    varying float vTrebleZone;
    varying vec2 vUv;

    float harmonic9D(vec3 p, float t) {
      float w1 = sin(p.x * uTension + t) * cos(p.y * uTension - t * 0.8);
      float w2 = sin(p.z * uTension * 1.5 + t * 1.2) * cos(length(p.xy) * 2.0 - t);
      float w3 = sin((p.x + p.y + p.z) * 3.0 - t * 1.7);
      return (w1 * 0.5 + w2 * 0.35 + w3 * 0.15);
    }

    float roundWave(float x, float amount) {
      float rounded = sin(x * 1.5707963);
      return mix(x, rounded, clamp(amount, 0.0, 1.0));
    }

    void main() {
      vUv = uv;
      vec3 pos = position;

      float bassZone = 1.0 - smoothstep(0.0, 0.95, abs(pos.y));
      float midBandWave = 0.5 + 0.5 * sin(pos.x * 3.2 - pos.y * 4.2 + uTime * 1.8);
      float midZone = midBandWave * (1.0 - 0.35 * bassZone);
      float polarMask = smoothstep(0.35, 1.35, abs(pos.y));
      float microRipple = sin(pos.x * 14.0 + uTime * 7.0) * cos(pos.z * 14.0 - uTime * 6.5);
      float trebleZone = clamp(polarMask * 0.75 + 0.25, 0.0, 1.0);

      vBassZone = bassZone * uBass;
      vMidZone = midZone * uMid;
      vTrebleZone = trebleZone * uTreble;

      float rawWave = harmonic9D(pos, uTime);
      float baseWave = roundWave(rawWave, uWaveRound * 0.75);

      float gapPull = 1.0 - uGapCondense * 0.28;
      float bassDisp = bassZone * uBass * (0.75 + 0.35 * sin(uTime * 3.0));
      float midDisp = midZone * uMid * (0.65 * sin(pos.z * 4.0 + uTime * 2.5));
      float trebleDisp = trebleZone * uTreble * (0.36 * roundWave(microRipple, uWaveRound));

      float pulseAge = uTime - uPulseTime;
      float shockwave = 0.0;
      if (pulseAge >= 0.0 && pulseAge < 2.5) {
        float radius = pulseAge * 4.5;
        float dist = abs(length(pos) - radius);
        shockwave = exp(-dist * 2.5) * sin(dist * 12.0) * (1.0 - pulseAge / 2.5) * 1.45;
      }

      float blueAge = uTime - uBluePulseTime;
      float blueWave = 0.0;
      if (blueAge >= 0.0 && blueAge < 2.8) {
        float bRadius = blueAge * 5.2;
        float bDist = abs(length(pos) - bRadius);
        blueWave = exp(-bDist * 2.2) * cos(bDist * 14.0 - blueAge * 10.0) * (1.0 - blueAge / 2.8) * 1.25;
      }

      float blueHarmonicBoost = uBlueMix * 0.16 * sin(pos.y * 5.0 + uTime * 3.5);
      float totalDisp = (baseWave * 0.35 * uDepth * gapPull) + bassDisp + midDisp + trebleDisp + shockwave + blueWave + blueHarmonicBoost;
      vDisplacement = totalDisp;

      vec3 displacedPos = pos + normal * totalDisp;
      vec4 worldPosition = modelMatrix * vec4(displacedPos, 1.0);
      vWorldPos = worldPosition.xyz;
      vNormal = normalize(normalMatrix * normal);

      gl_Position = projectionMatrix * viewMatrix * worldPosition;
    }
  </script>

  <script id="fragmentShader" type="x-shader/x-fragment">
    uniform float uTime;
    uniform int uMode;
    uniform float uMid;
    uniform float uTreble;
    uniform float uWaveRound;
    uniform float uBlueMix;

    varying vec3 vNormal;
    varying vec3 vWorldPos;
    varying float vDisplacement;
    varying float vBassZone;
    varying float vMidZone;
    varying float vTrebleZone;
    varying vec2 vUv;

    void main() {
      vec3 viewDir = normalize(cameraPosition - vWorldPos);
      float fresnel = pow(1.0 - abs(dot(viewDir, normalize(vNormal))), 2.6);

      vec3 coreHoney     = vec3(0.98, 0.55, 0.05);
      vec3 deepResin     = vec3(0.32, 0.09, 0.01);
      vec3 sovereignGold = vec3(1.00, 0.88, 0.45);

      vec3 electricBlue  = vec3(0.06, 0.62, 0.98);
      vec3 deepCobalt    = vec3(0.02, 0.10, 0.32);
      vec3 iceCyanRim    = vec3(0.55, 0.92, 1.00);
      vec3 plasmaCyan    = vec3(0.15, 0.90, 0.95);

      vec3 activeCore  = mix(coreHoney, electricBlue, uBlueMix);
      vec3 activeDeep  = mix(deepResin, deepCobalt, uBlueMix);
      vec3 activeRim   = mix(sovereignGold, iceCyanRim, uBlueMix);

      if (uMode == 1) {
        vec3 col = mix(activeCore, activeRim, fresnel + vTrebleZone * 0.4);
        gl_FragColor = vec4(col, 0.88);
        return;
      }

      if (uMode == 2) {
        float shift = clamp(vMidZone * 1.5 + vDisplacement * 0.5 + uBlueMix * 0.35, 0.0, 1.0);
        vec3 baseCol = mix(activeCore, plasmaCyan, shift);
        vec3 glow = mix(activeDeep, baseCol, fresnel + 0.25);
