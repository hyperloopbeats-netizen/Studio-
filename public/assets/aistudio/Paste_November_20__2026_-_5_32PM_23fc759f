        svg.setAttribute('viewBox', `0 0 ${stageRect.width} ${stageRect.height}`);
        svg.innerHTML = '';

        activeCables.forEach((cable) => {
          const elFrom = document.getElementById(cable.from);
          const elTo = document.getElementById(cable.to);
          if (!elFrom || !elTo) return;

          const r1 = elFrom.getBoundingClientRect();
          const r2 = elTo.getBoundingClientRect();

          const x1 = r1.left - stageRect.left + r1.width / 2;
          const y1 = r1.top - stageRect.top + r1.height / 2;
          const x2 = r2.left - stageRect.left + r2.width / 2;
          const y2 = r2.top - stageRect.top + r2.height / 2;

          // Gravity droop control points
          const midX = (x1 + x2) / 2;
          const droop = Math.max(45, Math.abs(y2 - y1) * 0.45 + Math.abs(x2 - x1) * 0.15);
          const ctrlY = Math.max(y1, y2) + droop;

          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', `M ${x1} ${y1} Q ${midX} ${ctrlY}, ${x2} ${y2}`);
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke', cable.color);
          path.setAttribute('stroke-width', cable.cv ? '2.5' : '4');
          path.setAttribute('stroke-linecap', 'round');
          path.setAttribute('opacity', '0.88');
          svg.appendChild(path);

          // Plug caps
          [ [x1, y1], [x2, y2] ].forEach(([cx, cy]) => {
            const cap = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            cap.setAttribute('cx', cx);
            cap.setAttribute('cy', cy);
            cap.setAttribute('r', cable.cv ? '4.5' : '6');
            cap.setAttribute('fill', cable.color);
            cap.setAttribute('stroke', '#090705');
            cap.setAttribute('stroke-width', '1.5');
            svg.appendChild(cap);
