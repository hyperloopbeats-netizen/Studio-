            pad.dataset.drumStep = s;
            pad.className = `step-pad h-6 rounded text-[9px] font-bold cursor-pointer ${s % 4 === 0 ? 'beat-group' : ''} ${isOn ? 'on text-black' : 'text-amber-500/40'}`;
            pad.textContent = (s % 4 === 0) ? (s / 4 + 1) : '·';
