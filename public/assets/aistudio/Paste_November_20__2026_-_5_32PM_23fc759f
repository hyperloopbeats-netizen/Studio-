<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>AIM-X // REASON STUDIO RACK // 9D AMBER MESH & HYPER-COMPRESSOR</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    :root {
      --rack-bg: #0c0a08;
      --chassis-dark: #161310;
      --chassis-mid: #201b16;
      --chassis-light: #2b241d;
      --amber: #f59e0b;
      --amber-bright: #fbbf24;
      --blue: #38bdf8;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Share Tech Mono', 'Inter', monospace;
      background-color: #070605;
      color: #fbbf24;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      user-select: none;
    }

    /* Brushed dark aluminum chassis texture */
    .rack-chassis {
      background:
        repeating-linear-gradient(
          0deg,
          rgba(255, 255, 255, 0.015) 0px,
          rgba(255, 255, 255, 0.015) 1px,
          transparent 1px,
          transparent 3px
        ),
        linear-gradient(180deg, #211c16 0%, #16120e 50%, #110e0b 100%);
      border: 1px solid rgba(245, 158, 11, 0.28);
      box-shadow:
        inset 0 1px 0 rgba(255, 220, 150, 0.12),
        inset 0 -2px 6px rgba(0, 0, 0, 0.75),
        0 8px 24px rgba(0, 0, 0, 0.65);
    }

    .rack-chassis.blue-mode {
      border-color: rgba(56, 189, 248, 0.45);
      box-shadow:
        inset 0 1px 0 rgba(186, 230, 253, 0.15),
        inset 0 -2px 6px rgba(0, 0, 0, 0.75),
        0 8px 28px rgba(2, 132, 199, 0.22);
    }

    /* Rack ears & screws */
    .rack-ear {
      background: linear-gradient(90deg, #120f0c, #1d1813 50%, #100d0a);
      border-right: 1px solid rgba(245, 158, 11, 0.18);
    }
    .rack-ear-right {
      background: linear-gradient(90deg, #100d0a, #1d1813 50%, #120f0c);
      border-left: 1px solid rgba(245, 158, 11, 0.18);
    }

    .rack-screw {
      width: 12px;
      height: 12px;
      border-radius: 9999px;
      background: radial-gradient(circle at 35% 35%, #6b5d4d, #27211b 70%, #0f0c09 100%);
      border: 1px solid #090705;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.2), 0 1px 2px rgba(0, 0, 0, 0.8);
      position: relative;
    }
    .rack-screw::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 2px;
      right: 2px;
      height: 1.5px;
      background: #0c0a08;
      transform: translateY(-50%) rotate(32deg);
    }

    /* Recessed LCD screen */
    .lcd-screen {
      background: radial-gradient(ellipse at center, #1b1306 0%, #0b0702 100%);
      border: 1px solid rgba(245, 158, 11, 0.42);
      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.9), 0 0 10px rgba(245, 158, 11, 0.12);
    }
    .blue-mode .lcd-screen {
      background: radial-gradient(ellipse at center, #061826 0%, #020911 100%);
      border-color: rgba(56, 189, 248, 0.5);
      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.9), 0 0 12px rgba(56, 189, 248, 0.18);
    }

    /* Hardware Fader / Range Slider */
    input[type="range"].hw-slider {
      -webkit-appearance: none;
      appearance: none;
      background: #0a0806;
      height: 6px;
      border-radius: 3px;
      border: 1px solid rgba(245, 158, 11, 0.28);
      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.9);
      outline: none;
    }
    input[type="range"].hw-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 14px;
      height: 18px;
      border-radius: 2px;
      background: linear-gradient(180deg, #fbbf24 0%, #b45309 100%);
      border: 1px solid #fef08a;
      cursor: pointer;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.85), 0 0 8px rgba(251, 191, 36, 0.45);
    }
    input[type="range"].hw-slider::-moz-range-thumb {
      width: 14px;
      height: 18px;
      border-radius: 2px;
      background: linear-gradient(180deg, #fbbf24 0%, #b45309 100%);
      border: 1px solid #fef08a;
      cursor: pointer;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.85);
    }
    .blue-mode input[type="range"].hw-slider::-webkit-slider-thumb {
      background: linear-gradient(180deg, #7dd3fc 0%, #0284c7 100%);
      border-color: #e0f2fe;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.85), 0 0 8px rgba(56, 189, 248, 0.55);
    }

    /* Tactile hardware button */
    .hw-btn {
      background: linear-gradient(180deg, #2d261e 0%, #1b1611 100%);
      border: 1px solid rgba(245, 158, 11, 0.35);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 2px 3px rgba(0, 0, 0, 0.7);
      transition: all 0.12s ease;
    }
    .hw-btn:active {
      transform: translateY(1px);
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.85);
    }
    .hw-btn.active {
      background: linear-gradient(180deg, rgba(245, 158, 11, 0.42) 0%, rgba(180, 83, 9, 0.55) 100%);
      border-color: #fbbf24;
      color: #fef3c7;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }
    .hw-btn.blue-active {
      background: linear-gradient(180deg, rgba(14, 165, 233, 0.55) 0%, rgba(3, 105, 161, 0.7) 100%);
      border-color: #7dd3fc;
      color: #f0f9ff;
      box-shadow: 0 0 14px rgba(56, 189, 248, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }

    /* Step Sequencer Pads */
    .step-pad {
      background: #14100c;
      border: 1px solid rgba(245, 158, 11, 0.22);
      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.85);
      transition: transform 0.08s ease, background-color 0.1s ease;
    }
    .step-pad.beat-group {
      border-top: 2px solid rgba(245, 158, 11, 0.5);
    }
    .step-pad.on {
      background: linear-gradient(180deg, #fbbf24 0%, #d97706 100%);
      border-color: #fef08a;
      box-shadow: 0 0 10px rgba(251, 191, 36, 0.55);
    }
    .blue-mode .step-pad.on {
      background: linear-gradient(180deg, #38bdf8 0%, #0284c7 100%);
      border-color: #e0f2fe;
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
    }
    .step-pad.playing {
      outline: 2px solid #ffffff;
      transform: scale(1.06);
      z-index: 2;
    }

    /* 1/4" TRS & CV Jacks for Rear Patch Bay */
    .trs-jack {
      width: 28px;
      height: 28px;
      border-radius: 9999px;
      background: radial-gradient(circle, #050505 34%, #52525b 38%, #a1a1aa 52%, #27272a 68%, #09090b 100%);
      border: 2px solid #18181b;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.9), inset 0 1px 1px rgba(255, 255, 255, 0.35);
      cursor: pointer;
      position: relative;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .trs-jack:hover {
      transform: scale(1.12);
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.75);
    }
    .trs-jack.cv-jack {
      width: 22px;
      height: 22px;
      border-color: #0284c7;
    }
    .trs-jack.selected-jack {
      box-shadow: 0 0 0 3px #38bdf8, 0 0 16px #38bdf8;
    }

    /* Fullscreen viewport popout mode */
    .viewport-popout {
      position: fixed !important;
      inset: 0 !important;
      z-index: 60 !important;
      width: 100vw !important;
      height: 100vh !important;
      border-radius: 0 !important;
      margin: 0 !important;
    }

    /* Custom subtle scrollbar */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: #0a0806;
    }
    ::-webkit-scrollbar-thumb {
      background: #3a2e22;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #f59e0b;
    }
  </style>
</head>
<body id="app-root" class="min-h-screen bg-[#070605] text-amber-400 flex flex-col">

  <!-- Non-blocking Studio Toast Banner -->
  <div id="status-banner" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-lg bg-[#14100c]/95 border border-amber-400/70 text-xs text-amber-100 shadow-[0_0_24px_rgba(245,158,11,0.35)] backdrop-blur-md max-w-[92vw] text-center">
    <span id="status-banner-text">AIM-X Reason Studio Rack Initialized</span>
  </div>

  <!-- ===================================================================== -->
  <!-- TOP MASTER TRANSPORT & STUDIO HEADER BAR (STICKY)                     -->
  <!-- ===================================================================== -->
  <header class="sticky top-0 z-40 w-full bg-[#110e0b]/95 backdrop-blur-md border-b border-amber-500/35 shadow-[0_4px_20px_rgba(0,0,0,0.85)]">
    <div class="max-w-[1440px] mx-auto px-2 sm:px-4 py-2 flex flex-wrap items-center justify-between gap-2">

      <!-- Brand & Audio Engine Boot -->
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-md bg-gradient-to-br from-amber-500 to-amber-800 border border-amber-300 flex items-center justify-center shadow-[0_0_14px_rgba(245,158,11,0.45)]">
          <span class="text-black font-extrabold text-sm">AX</span>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <h1 class="text-xs sm:text-sm font-bold tracking-widest text-amber-200">AIM-X // REASON RACK</h1>
            <span id="engine-led" class="w-2 h-2 rounded-full bg-amber-500/40"></span>
          </div>
          <p class="text-[10px] text-amber-400/70 hidden sm:block">9D AMBER MESH + SILENCE-GAP HYPER-COMPRESSOR STUDIO</p>
        </div>
      </div>

      <!-- Master Transport Controls -->
      <div class="flex items-center gap-1.5 bg-[#090705] px-2 py-1 rounded-lg border border-amber-500/25">
        <button id="transport-play" type="button" class="hw-btn px-3 py-1.5 rounded text-xs font-bold text-emerald-300 flex items-center gap-1 cursor-pointer">
          <span>▶</span> <span class="hidden sm:inline">PLAY</span>
        </button>
        <button id="transport-stop" type="button" class="hw-btn px-3 py-1.5 rounded text-xs font-bold text-rose-300 flex items-center gap-1 cursor-pointer">
          <span>■</span> <span class="hidden sm:inline">STOP</span>
        </button>

        <!-- BPM Readout & Adjust -->
        <div class="lcd-screen px-2 py-1 rounded flex items-center gap-1.5 ml-1">
          <span class="text-[10px] text-amber-400/75">BPM</span>
          <input id="transport-bpm" type="number" min="60" max="180" value="124" class="w-11 bg-transparent text-amber-200 font-bold text-xs text-center focus:outline-none" />
          <div class="flex flex-col leading-none">
            <button id="bpm-up" type="button" class="text-[9px] text-amber-300 hover:text-white px-0.5">▲</button>
            <button id="bpm-down" type="button" class="text-[9px] text-amber-300 hover:text-white px-0.5">▼</button>
          </div>
        </div>

        <!-- Step Counter LED -->
        <div class="lcd-screen px-2 py-1 rounded hidden md:flex items-center gap-1.5">
          <span class="text-[10px] text-amber-400/75">BAR.STEP</span>
          <span id="transport-step-lcd" class="text-xs font-bold text-amber-200">01.01</span>
        </div>
      </div>

      <!-- Master Volume, Stereo Peak Meter, DSP Load & RACK FLIP [TAB] -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Stereo L/R LED Peak Bars -->
        <div class="hidden sm:flex flex-col gap-1 w-24 bg-[#090705] p-1.5 rounded border border-amber-500/25">
          <div class="flex items-center gap-1">
            <span class="text-[9px] text-amber-400/80 w-2">L</span>
            <div class="flex-1 h-1.5 bg-black rounded-sm overflow-hidden">
              <div id="master-vu-l" class="h-full w-0 bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 transition-[width] duration-75"></div>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <span class="text-[9px] text-amber-400/80 w-2">R</span>
            <div class="flex-1 h-1.5 bg-black rounded-sm overflow-hidden">
              <div id="master-vu-r" class="h-full w-0 bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 transition-[width] duration-75"></div>
            </div>
          </div>
        </div>

        <!-- Master Volume -->
        <div class="hidden lg:flex items-center gap-1.5 bg-[#090705] px-2.5 py-1.5 rounded border border-amber-500/25">
          <span class="text-[10px] text-amber-400/80">MST</span>
          <input id="master-vol" type="range" min="0" max="1.25" step="0.01" value="0.85" class="hw-slider w-20" />
          <span id="master-vol-val" class="text-[10px] text-amber-200 w-8 text-right">85%</span>
        </div>

        <!-- DSP Load Readout -->
        <div class="lcd-screen px-2 py-1 rounded hidden xl:flex flex-col items-end">
          <span class="text-[9px] text-amber-400/70">DSP / FPS</span>
          <span id="dsp-load-readout" class="text-[11px] text-emerald-300 font-bold">14% · 60Hz</span>
        </div>

        <!-- RACK FLIP [TAB] BUTTON -->
        <button id="btn-flip-rack" type="button" class="hw-btn px-3 py-1.5 rounded-md text-xs font-bold tracking-wider text-sky-300 border-sky-400/60 flex items-center gap-1.5 cursor-pointer" title="Press TAB or click to flip rack 180°">
          <span>⇄</span>
          <span id="flip-btn-label">FLIP RACK [TAB]</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- MAIN 19-INCH STUDIO RACK CONTAINER (FRONT PANEL VIEW)                 -->
  <!-- ===================================================================== -->
  <main id="rack-front-view" class="flex-1 w-full max-w-[1400px] mx-auto px-2 sm:px-4 py-4 space-y-3.5">

    <!-- =================================================================== -->
    <!-- UNIT 01 // AIM-M1 4-CHANNEL STUDIO MIXER & AUDIO INPUT DECK (2U)    -->
    <!-- =================================================================== -->
    <section class="rack-chassis rounded-lg overflow-hidden flex">
      <!-- Left Rack Ear -->
      <div class="rack-ear w-5 sm:w-7 flex flex-col justify-between items-center py-3 shrink-0">
        <div class="rack-screw"></div>
        <div class="rack-screw"></div>
      </div>

      <!-- Unit Body -->
      <div class="flex-1 min-w-0">
        <!-- Unit Faceplate Header -->
        <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 bg-black/40 border-b border-amber-500/25">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_#fbbf24]"></span>
            <span class="text-xs font-bold tracking-widest text-amber-200">UNIT 01 // AIM-M1 4-CH STUDIO MIXER &amp; SOURCE BUS</span>
          </div>
          <div class="flex items-center gap-2">
            <span id="hud-source" class="lcd-screen px-2 py-0.5 rounded text-[10px] text-amber-200 font-bold">BUS: STANDBY</span>
            <button type="button" data-collapse="unit-01-body" class="collapse-unit-btn hw-btn px-2 py-0.5 rounded text-[10px] text-amber-300">[−]</button>
          </div>
        </div>

        <!-- Unit Content -->
        <div id="unit-01-body" class="p-3 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-3">
          <!-- Channel 1: 432Hz Sovereign Drone Synth -->
          <div class="bg-[#110e0b] border border-amber-500/25 rounded-lg p-2.5 flex flex-col justify-between gap-2">
            <div class="flex items-center justify-between border-b border-amber-500/20 pb-1">
              <span class="text-[11px] font-bold text-amber-300">CH 1 // 432Hz DRONE</span>
              <div class="flex gap-1">
                <button id="ch1-mute" type="button" class="hw-btn px-1.5 py-0.5 rounded text-[9px] font-bold text-rose-300">M</button>
                <button id="ch1-solo" type="button" class="hw-btn px-1.5 py-0.5 rounded text-[9px] font-bold text-amber-200">S</button>
              </div>
            </div>

            <button id="btn-synth" type="button" class="hw-btn w-full py-1.5 rounded text-xs font-bold text-amber-200">
              ▶ ENGAGE 432Hz DRONE
            </button>

            <div class="space-y-1.5 text-[10px]">
              <div>
                <div class="flex justify-between"><span>GAIN LEVEL</span><span id="ch1-vol-val">75%</span></div>
                <input id="ch1-vol" type="range" min="0" max="1.2" step="0.01" value="0.75" class="hw-slider w-full" />
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <div class="flex justify-between"><span>LOW EQ</span><span id="ch1-low-val">0dB</span></div>
                  <input id="ch1-low" type="range" min="-12" max="12" step="1" value="0" class="hw-slider w-full" />
                </div>
                <div>
                  <div class="flex justify-between"><span>HIGH EQ</span><span id="ch1-high-val">0dB</span></div>
                  <input id="ch1-high" type="range" min="-12" max="12" step="1" value="0" class="hw-slider w-full" />
                </div>
              </div>
              <div>
                <div class="flex justify-between"><span>PAN L/R</span><span id="ch1-pan-val">C</span></div>
                <input id="ch1-pan" type="range" min="-1" max="1" step="0.05" value="0" class="hw-slider w-full" />
              </div>
            </div>
          </div>

          <!-- Channel 2: Subtractor-9D Poly Synth -->
          <div class="bg-[#110e0b] border border-amber-500/25 rounded-lg p-2.5 flex flex-col justify-between gap-2">
            <div class="flex items-center justify-between border-b border-amber-500/20 pb-1">
              <span class="text-[11px] font-bold text-amber-300">CH 2 // SUBTRACTOR-9D</span>
              <div class="flex gap-1">
                <button id="ch2-mute" type="button" class="hw-btn px-1.5 py-0.5 rounded text-[9px] font-bold text-rose-300">M</button>
                <button id="ch2-solo" type="button" class="hw-btn px-1.5 py-0.5 rounded text-[9px] font-bold text-amber-200">S</button>
              </div>
            </div>

            <div class="lcd-screen px-2 py-1 rounded text-[10px] text-center text-amber-300/90">
              ROUTED FROM UNIT 02 SEQ
            </div>

            <div class="space-y-1.5 text-[10px]">
              <div>
                <div class="flex justify-between"><span>GAIN LEVEL</span><span id="ch2-vol-val">80%</span></div>
                <input id="ch2-vol" type="range" min="0" max="1.2" step="0.01" value="0.80" class="hw-slider w-full" />
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <div class="flex justify-between"><span>LOW EQ</span><span id="ch2-low-val">+2dB</span></div>
                  <input id="ch2-low" type="range" min="-12" max="12" step="1" value="2" class="hw-slider w-full" />
                </div>
                <div>
                  <div class="flex justify-between"><span>HIGH EQ</span><span id="ch2-high-val">+1dB</span></div>
                  <input id="ch2-high" type="range" min="-12" max="12" step="1" value="1" class="hw-slider w-full" />
                </div>
              </div>
              <div>
                <div class="flex justify-between"><span>PAN L/R</span><span id="ch2-pan-val">C</span></div>
                <input id="ch2-pan" type="range" min="-1" max="1" step="0.05" value="0" class="hw-slider w-full" />
              </div>
            </div>
          </div>

          <!-- Channel 3: Redrum-X16 Drum Computer -->
          <div class="bg-[#110e0b] border border-amber-500/25 rounded-lg p-2.5 flex flex-col justify-between gap-2">
            <div class="flex items-center justify-between border-b border-amber-500/20 pb-1">
              <span class="text-[11px] font-bold text-amber-300">CH 3 // REDRUM-X16</span>
              <div class="flex gap-1">
                <button id="ch3-mute" type="button" class="hw-btn px-1.5 py-0.5 rounded text-[9px] font-bold text-rose-300">M</button>
                <button id="ch3-solo" type="button" class="hw-btn px-1.5 py-0.5 rounded text-[9px] font-bold text-amber-200">S</button>
              </div>
            </div>

            <div class="lcd-screen px-2 py-1 rounded text-[10px] text-center text-amber-300/90">
              ROUTED FROM UNIT 03 DRUMS
            </div>

            <div class="space-y-1.5 text-[10px]">
              <div>
                <div class="flex justify-between"><span>GAIN LEVEL</span><span id="ch3-vol-val">90%</span></div>
                <input id="ch3-vol" type="range" min="0" max="1.2" step="0.01" value="0.90" class="hw-slider w-full" />
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <div class="flex justify-between"><span>LOW EQ</span><span id="ch3-low-val">+3dB</span></div>
                  <input id="ch3-low" type="range" min="-12" max="12" step="1" value="3" class="hw-slider w-full" />
                </div>
                <div>
                  <div class="flex justify-between"><span>HIGH EQ</span><span id="ch3-high-val">+2dB</span></div>
                  <input id="ch3-high" type="range" min="-12" max="12" step="1" value="2" class="hw-slider w-full" />
                </div>
              </div>
              <div>
                <div class="flex justify-between"><span>PAN L/R</span><span id="ch3-pan-val">C</span></div>
                <input id="ch3-pan" type="range" min="-1" max="1" step="0.05" value="0" class="hw-slider w-full" />
              </div>
            </div>
          </div>

          <!-- Channel 4: Live Mic & MP3 Audio Deck -->
          <div class="bg-[#110e0b] border border-amber-500/25 rounded-lg p-2.5 flex flex-col justify-between gap-2">
            <div class="flex items-center justify-between border-b border-amber-500/20 pb-1">
